# Production data source: Google Apps Script / Google Sheets
APPS_SCRIPT_API_URL=
APPS_SCRIPT_API_KEY=

# PDF Import Center: bảo vệ khu vực ghi dữ liệu.
# PIN chỉ nhập qua HTTPS; secret dùng để ký session 4 giờ ở Vercel server.
PDF_ADMIN_PIN=
PDF_ADMIN_SECRET=

# Weather (MET Norway requires an identifying User-Agent with contact information)
# Example: sxkd-dashboard/1.8.3 your-email@example.com
WEATHER_USER_AGENT=

# AI Điều hành nội bộ, không gọi API bên ngoài.
AI_MODE=local
