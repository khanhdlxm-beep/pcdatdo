# Dashboard data mode
# true = dữ liệu DEMO 2025-2026; false = đọc dữ liệu thật từ Apps Script / Google Sheets.
USE_DEMO_DATA=true

# Google Apps Script Web App backend
APPS_SCRIPT_API_URL=
APPS_SCRIPT_API_KEY=

# PDF Import Center: bảo vệ khu vực ghi dữ liệu.
# PIN chỉ nhập qua HTTPS; secret dùng để ký session 4 giờ ở Vercel server.
PDF_ADMIN_PIN=
PDF_ADMIN_SECRET=

# Weather (MET Norway requires an identifying User-Agent with contact information)
# Example: sxkd-dashboard/1.6.0 your-email@example.com
WEATHER_USER_AGENT=

# V1.8.0 AI Điều hành
# local = AI nội bộ miễn phí, không gọi API bên ngoài.
AI_MODE=local
