# Production data source: Google Apps Script / Google Sheets
APPS_SCRIPT_API_URL=
APPS_SCRIPT_API_KEY=

# PDF Import Center. Dùng secret riêng, không tái sử dụng API key.
PDF_ADMIN_PIN=
PDF_ADMIN_SECRET=

# Weather (MET Norway yêu cầu User-Agent nhận diện ứng dụng + thông tin liên hệ)
# Ví dụ: sxkd-dashboard/1.8.5 your-email@example.com
WEATHER_USER_AGENT=

# Trợ lý điều hành hiện chạy local analytics, không gọi AI API bên ngoài.
AI_MODE=local
